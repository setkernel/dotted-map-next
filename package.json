{
  "name": "@setkernel/dotted-map-next",
  "version": "1.1.1",
  "description": "Create beautiful SVG maps filled with dots for the world or countries - Enhanced with security fixes, performance improvements, and modern tooling",
  "main": "./index.js",
  "types": "./index.d.ts",
  "module": "./index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./without-countries": {
      "types": "./without-countries.d.ts",
      "import": "./without-countries.mjs",
      "require": "./without-countries.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "node test.js",
    "test:enhanced": "node test.enhanced.js",
    "test:all": "npm test && npm run test:enhanced",
    "dev": "tsup --watch",
    "clean": "node -e \"const fs = require('fs'); ['index.js', 'index.mjs', 'without-countries.js', 'without-countries.mjs'].forEach((f) => fs.rmSync(f, { force: true }));\"",
    "prepack": "npm run clean && npm run build",
    "format": "prettier --write src/**/*.js *.js",
    "format:check": "prettier --check src/**/*.js *.js",
    "size": "ls -l index.js index.mjs without-countries.js without-countries.mjs"
  },
  "keywords": [
    "map",
    "svg",
    "dots",
    "dotted",
    "world",
    "countries",
    "country",
    "visualization",
    "geography",
    "geojson",
    "data-visualization",
    "interactive",
    "charts",
    "graphics",
    "secure",
    "performance"
  ],
  "author": "Basile Bruneau <basile@bruneau.email>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/setkernel/dotted-map-next.git"
  },
  "bugs": {
    "url": "https://github.com/setkernel/dotted-map-next/issues"
  },
  "homepage": "https://github.com/setkernel/dotted-map-next#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "without-countries.js",
    "without-countries.mjs",
    "without-countries.d.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@turf/boolean-point-in-polygon": "7.4.0",
    "proj4": "2.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "sideEffects": false
}
