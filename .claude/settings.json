{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f package-lock.json ]; then npm ci --no-audit --no-fund >/dev/null 2>&1; fi; if [ -n \"$CLAUDE_CODE_REMOTE\" ] && [ -x .claude/cloud-setup.sh ]; then .claude/cloud-setup.sh; fi; exit 0"
          }
        ]
      }
    ]
  }
}
